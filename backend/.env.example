# ==========================================
# QuickKart Backend Environment Configuration
# ==========================================

# Core Server & Database (Required)
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickkart?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
FRONTEND_URL=http://localhost:5173

# Account Security & OTP Configuration
OTP_HASH_SECRET=your_dedicated_otp_hmac_secret_key_random_string
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ==========================================
# Email Configuration (Gmail SMTP)
# Uses your Gmail address and 16-character Google App Password
# ==========================================
EMAIL_PROVIDER=smtp
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="QuickKart <your_email@gmail.com>"

# Optional Custom SMTP (leave commented to use default service: 'gmail')
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
